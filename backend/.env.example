SECRET_KEY=generate-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_NAME=myclub
DB_USER=myclub
DB_PASSWORD=change-this-local-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Source database used only by `python manage.py migrate_from_mongodb`.
MONGO_DB=clubsite_db
MONGO_URI=mongodb://localhost:27017/clubsite_db

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# Configure SMTP before enabling password reset emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MyClub <no-reply@example.org>

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
